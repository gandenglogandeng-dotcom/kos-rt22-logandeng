# Salin isi file ini ke Environment Variables di dashboard Vercel.
# JANGAN pernah commit file .env asli (berisi kredensial) ke GitHub — makanya
# .env sudah dimasukkan ke .gitignore. File .env.example ini aman di-commit
# karena isinya cuma contoh placeholder, bukan kredensial asli.

# ========== Untuk SHEETS (baca/tulis Spreadsheet) — pakai Service Account ==========
# Dari Google Cloud Console > IAM & Admin > Service Accounts > (akun) > Keys > JSON
GOOGLE_SERVICE_ACCOUNT_EMAIL=nama-service-account@nama-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"

# ID Spreadsheet (ambil dari URL: .../spreadsheets/d/ID_INI/edit)
SPREADSHEET_ID=

# ========== Untuk DRIVE (unggah KTP/Nikah/KK) — WAJIB pakai akun Google ASLI ==========
# Service Account TIDAK BISA dipakai untuk ini (Google selalu menolak dengan error
# "storageQuotaExceeded" karena Service Account tidak punya jatah penyimpanan).
# Cara mendapatkan 3 nilai di bawah: lihat PANDUAN.md bagian "OAuth Drive".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ID folder Google Drive tempat menyimpan KTP/Buku Nikah/KK (ambil dari URL folder).
# Folder ini harus dibuat oleh akun Google yang SAMA dengan yang dipakai di OAuth di atas.
DRIVE_FOLDER_ID=

# Kode rahasia untuk link dashboard Pak RT. Buat sendiri, acak, minimal 24 karakter.
RT_TOKEN=

# Ditampilkan di judul halaman form, poster, dan dashboard RT
NAMA_DESA=Desa Logandeng RT 21
